text = "一口湖，湖中的石制平台插着一把剑，这似乎是很经典的桥段。我会拔这把剑么？"
autowrap_mode = 2

[node name="PullButton" parent="." instance=ExtResource("3_button")]
layout_mode = 0
offset_left = 730.0
offset_top = 575.0
offset_right = 1450.0
offset_bottom = 670.0
pressed_desc = Array[String](["我应当拔出这把剑，这把剑也应当由我来拔出，这是只属于我的剑。", "剑纹丝不动。湖面倒映着我略微失望的神情。"])
desc_text = "尝试拔剑"
detail_text = "成功获得命定之剑；失败获得略微的失望。幸运提高成功机会"

[node name="PlatformButton" parent="." instance=ExtResource("3_button")]
layout_mode = 0
offset_left = 730.0
