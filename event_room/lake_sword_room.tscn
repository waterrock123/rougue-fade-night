offset_right = 1450.0
offset_bottom = 805.0
pressed_desc = Array[String](["我对于做选择没有兴趣，我的力量足够连带剑与平台一起拔出并扛走。我就是这么强。"])
desc_text = "我的力气够大……"
detail_text = "需要力量至少20点：获得命定的石锤？"

