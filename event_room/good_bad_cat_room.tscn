[node name="DescLabel" type="Label" parent="."]
layout_mode = 0
offset_left = 700.0
offset_top = 100.0
offset_right = 1820.0
offset_bottom = 470.0
theme_override_font_sizes/font_size = 38
text = "有一只喵咪静静地趴在那里。它会让人摸么？它会哈气么？一切只有试了才知道。"
autowrap_mode = 2

[node name="PetButton" parent="." instance=ExtResource("3_button")]
layout_mode = 0
offset_left = 730.0
offset_top = 505.0
offset_right = 1450.0
offset_bottom = 600.0
pressed_desc = Array[String](["真是个好猫，你抚摸了它好一会儿才停，心情愉悦。", "这猫不是很亲人，你一靠近就哈气，同时它还举起爪子打人，也太不礼貌了……"])
desc_text = "不管了，先摸摸看呗"
detail_text = "好猫获得自然的喜悦；坏猫获得不散的郁闷"

[node name="ObserveButton" parent="." instance=ExtResource("3_button")]
layout_mode = 0
offset_left = 730.0
offset_top = 630.0
offset_right = 1450.0
offset_bottom = 725.0
pressed_desc = Array[String](["经过我的仔细观察，这应该是只好猫。", "经过我的仔细观察，这只猫看起来不像好猫。"])
desc_text = "让我仔细观察观察"
detail_text = "需要背包中有洞察标签装备：确定猫咪是好猫还是坏猫，然后再决定是否抚摸"

[node name="CharmButton" parent="." instance=ExtResource("3_button")]
layout_mode = 0
offset_left = 730.0
offset_top = 755.0
offset_right = 1450.0
offset_bottom = 850.0
pressed_desc = Array[String](["管它什么好猫坏猫，到了我手上的都是好猫。"])
desc_text = "看看我的无敌亲和力"
detail_text = "需要魅力至少10点：使猫咪变为好猫，获得自然的喜悦"

[node name="LeaveButton" type="Button" parent="."]
layout_mode = 0
offset_left = 1510.0
offset_top = 865.0
offset_right = 1830.0
offset_bottom = 965.0
theme_override_font_sizes/font_size = 48
text = "离开"

[connection signal="pressed" from="LeaveButton" to="." method="_on_leave_button_pressed"]
