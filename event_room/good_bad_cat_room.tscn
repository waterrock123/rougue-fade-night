[ext_resource type="Texture2D" path="res://assets/ai art/事件背景/《好基米坏基米》.png" id="2_background"]
[ext_resource type="PackedScene" path="res://event_room/event_button.tscn" id="3_button"]

[node name="GoodBadCatRoom" type="Control"]
layout_mode = 3
