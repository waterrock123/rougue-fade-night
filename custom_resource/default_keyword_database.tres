desc = "主要属性之一，通常增强远程伤害，并影响灵巧类效果。"
color = Color(0.55, 1, 0.52, 1)

[sub_resource type="Resource" id="KeywordData_intelligence"]
script = ExtResource("2_data")
id = &"intelligence"
display_name = "智力"
