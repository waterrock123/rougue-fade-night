[ext_resource type="Script" uid="uid://ch81dd8m0eyf" path="res://custom_resource/keyword_data.gd" id="2_data"]

[sub_resource type="Resource" id="KeywordData_armor"]
script = ExtResource("2_data")
id = &"armor"
display_name = "护甲"
desc = "减少受到的固定伤害。"
color = Color(0.55, 0.78, 1, 1)

[sub_resource type="Resource" id="KeywordData_weak"]
script = ExtResource("2_data")
id = &"weak"
display_name = "虚弱"
desc = "力量、敏捷、速度降低。"
color = Color(0.85, 0.68, 1, 1)

[sub_resource type="Resource" id="KeywordData_strength"]
script = ExtResource("2_data")
id = &"strength"
display_name = "力量"
desc = "主要属性之一，通常增强近战与物理类伤害。"
color = Color(1, 0.45, 0.38, 1)

[sub_resource type="Resource" id="KeywordData_dexterity"]
script = ExtResource("2_data")
id = &"dexterity"
display_name = "敏捷"
desc = "主要属性之一，通常增强远程伤害，并影响灵巧类效果。"
color = Color(0.55, 1, 0.52, 1)

[sub_resource type="Resource" id="KeywordData_intelligence"]
script = ExtResource("2_data")
id = &"intelligence"
display_name = "智力"
desc = "主要属性之一，通常影响法术、技能或特殊效果。"
color = Color(0.55, 0.78, 1, 1)

[sub_resource type="Resource" id="KeywordData_constitution"]
script = ExtResource("2_data")
id = &"constitution"
display_name = "体质"
desc = "主要属性之一，提高最大生命值，并影响战斗后的恢复量。"
color = Color(1, 0.62, 0.42, 1)

[sub_resource type="Resource" id="KeywordData_speed"]
script = ExtResource("2_data")
id = &"speed"
display_name = "速度"
desc = "影响实体的移动速度。"
color = Color(0.62, 0.95, 1, 1)

[sub_resource type="Resource" id="KeywordData_charm"]
script = ExtResource("2_data")
id = &"charm"
display_name = "魅力"
desc = "主要属性之一，可用于商店、社交或特殊装备效果。"
color = Color(1, 0.65, 0.95, 1)

[sub_resource type="Resource" id="KeywordData_luck"]
script = ExtResource("2_data")
id = &"luck"
display_name = "幸运"
desc = "主要属性之一，通常影响概率类效果。"
color = Color(1, 0.92, 0.45, 1)

[sub_resource type="Resource" id="KeywordData_bleed"]
script = ExtResource("2_data")
id = &"bleed"
display_name = "流血"
desc = "持续30秒，可叠层；每5秒受到层数对应的物理伤害，并随机一级属性-1直到战斗结束。"
color = Color(0.92, 0.12, 0.12, 1)

[sub_resource type="Resource" id="KeywordData_freeze"]
script = ExtResource("2_data")
id = &"freeze"
display_name = "冻结"
desc = "控制类状态，仅有一层；持续期间无法行动并停止动画，体质可以减免持续时间。"
color = Color(0.55, 0.9, 1, 1)

[sub_resource type="Resource" id="KeywordData_sleep"]
script = ExtResource("2_data")
id = &"sleep"
display_name = "睡眠"
desc = "控制类状态，通常会让目标暂时失去行动能力。"
color = Color(0.72, 0.65, 1, 1)

[sub_resource type="Resource" id="KeywordData_paralysis"]
script = ExtResource("2_data")
id = &"paralysis"
display_name = "麻痹"
desc = "无持续时间，可叠层；目标释放主动技能时受到50点闪电伤害，并清除一层。"
color = Color(1, 0.88, 0.28, 1)

[sub_resource type="Resource" id="KeywordData_slow"]
script = ExtResource("2_data")
id = &"slow"
display_name = "减速"
desc = "负面状态，降低目标移动速度。"
color = Color(0.5, 0.75, 1, 1)

[sub_resource type="Resource" id="KeywordData_gold"]
script = ExtResource("2_data")
