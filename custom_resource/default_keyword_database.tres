[gd_resource type="Resource" script_class="KeywordDatabase" format=3 uid="uid://43iaiydh8o6o"]

[ext_resource type="Script" uid="uid://bkgl6exi5mm4l" path="res://custom_resource/keyword_database.gd" id="1_db"]
[ext_resource type="Script" uid="uid://ch81dd8m0eyf" path="res://custom_resource/keyword_data.gd" id="2_data"]

[sub_resource type="Resource" id="KeywordData_armor"]
script = ExtResource("2_data")
id = &"armor"
display_name = "护甲"
desc = "减少受到的固定伤害。"
color = Color(0.55, 0.78, 1, 1)

[sub_resource type="Resource" id="KeywordData_weak"]
script = ExtResource("2_data")
id = &"weak"
display_name = "虚弱"
desc = "力量、敏捷、速度降低。"
color = Color(0.85, 0.68, 1, 1)

[sub_resource type="Resource" id="KeywordData_strength"]
script = ExtResource("2_data")
id = &"strength"
display_name = "力量"
desc = "主要属性之一，通常增强近战与物理类伤害。"
color = Color(1, 0.45, 0.38, 1)

[sub_resource type="Resource" id="KeywordData_dexterity"]
script = ExtResource("2_data")
id = &"dexterity"
display_name = "敏捷"
desc = "主要属性之一，通常增强远程伤害，并影响灵巧类效果。"
color = Color(0.55, 1, 0.52, 1)

[sub_resource type="Resource" id="KeywordData_intelligence"]
script = ExtResource("2_data")
id = &"intelligence"
display_name = "智力"
desc = "主要属性之一，通常影响法术、技能或特殊效果。"
color = Color(0.55, 0.78, 1, 1)

[sub_resource type="Resource" id="KeywordData_constitution"]
script = ExtResource("2_data")
id = &"constitution"
display_name = "体质"
desc = "主要属性之一，提高最大生命值，并影响战斗后的恢复量。"
color = Color(1, 0.62, 0.42, 1)

[sub_resource type="Resource" id="KeywordData_speed"]
script = ExtResource("2_data")
id = &"speed"
display_name = "速度"
desc = "影响实体的移动速度。"
color = Color(0.62, 0.95, 1, 1)

[sub_resource type="Resource" id="KeywordData_charm"]
script = ExtResource("2_data")
id = &"charm"
display_name = "魅力"
desc = "主要属性之一，可用于商店、社交或特殊装备效果。"
color = Color(1, 0.65, 0.95, 1)

[sub_resource type="Resource" id="KeywordData_luck"]
script = ExtResource("2_data")
id = &"luck"
display_name = "幸运"
desc = "主要属性之一，通常影响概率类效果。"
color = Color(1, 0.92, 0.45, 1)

[sub_resource type="Resource" id="KeywordData_bleed"]
script = ExtResource("2_data")
id = &"bleed"
display_name = "流血"
desc = "持续30秒，可叠层；每5秒受到层数对应的物理伤害，并随机一级属性-1直到战斗结束。"
color = Color(0.92, 0.12, 0.12, 1)

[sub_resource type="Resource" id="KeywordData_freeze"]
script = ExtResource("2_data")
id = &"freeze"
display_name = "冻结"
desc = "控制类状态，仅有一层；持续期间无法行动并停止动画，体质可以减免持续时间。"
color = Color(0.55, 0.9, 1, 1)

[sub_resource type="Resource" id="KeywordData_sleep"]
script = ExtResource("2_data")
id = &"sleep"
display_name = "睡眠"
desc = "控制类状态，通常会让目标暂时失去行动能力。"
color = Color(0.72, 0.65, 1, 1)

[sub_resource type="Resource" id="KeywordData_paralysis"]
script = ExtResource("2_data")
id = &"paralysis"
display_name = "麻痹"
desc = "无持续时间，可叠层；目标释放主动技能时受到50点闪电伤害，并清除一层。"
color = Color(1, 0.88, 0.28, 1)

[sub_resource type="Resource" id="KeywordData_slow"]
script = ExtResource("2_data")
id = &"slow"
display_name = "减速"
desc = "负面状态，降低目标移动速度。"
color = Color(0.5, 0.75, 1, 1)

[sub_resource type="Resource" id="KeywordData_gold"]
script = ExtResource("2_data")
id = &"gold"
display_name = "金币"
desc = "本局中的商店货币，可用于购买装备或刷新商店。"
color = Color(1, 0.8, 0.25, 1)

[sub_resource type="Resource" id="KeywordData_shop_refresh"]
script = ExtResource("2_data")
id = &"shop_refresh"
display_name = "商店刷新"
desc = "重新生成商店中的可购买装备。"
color = Color(0.65, 0.95, 0.8, 1)

[sub_resource type="Resource" id="KeywordData_active_skill"]
script = ExtResource("2_data")
id = &"active_skill"
display_name = "主动技能"
desc = "需要玩家主动按键释放的技能。"
color = Color(0.75, 0.75, 1, 1)

[sub_resource type="Resource" id="KeywordData_consumable"]
script = ExtResource("2_data")
id = &"consumable"
display_name = "消耗品"
desc = "使用后会消耗或触发一次性效果的装备。"
color = Color(0.95, 0.75, 0.45, 1)

[sub_resource type="Resource" id="KeywordData_physical_damage"]
script = ExtResource("2_data")
id = &"physical_damage"
display_name = "物理伤害"
desc = "常见伤害类型，可被护甲或其他减伤效果影响。"
color = Color(0.95, 0.62, 0.5, 1)

[sub_resource type="Resource" id="KeywordData_heal"]
script = ExtResource("2_data")
id = &"heal"
display_name = "恢复"
desc = "回复生命值，但通常不会超过最大生命值。"
color = Color(0.55, 1, 0.55, 1)

[sub_resource type="Resource" id="KeywordData_sharp"]
script = ExtResource("2_data")
id = &"sharp"
display_name = "锋锐"
desc = "进攻类增益，通常代表更强的攻击能力。"
color = Color(1, 0.55, 0.35, 1)

[sub_resource type="Resource" id="KeywordData_vulnerable"]
script = ExtResource("2_data")
id = &"vulnerable"
display_name = "易伤"
desc = "负面状态，通常会使目标受到更多伤害。"
color = Color(1, 0.42, 0.42, 1)

[sub_resource type="Resource" id="Resource_5ukev"]
script = ExtResource("2_data")
id = &"burn"
display_name = "燃烧"
desc = "每秒受到层数对应的火焰伤害；可叠层，每次叠层重置为8秒。"
color = Color(0.8582719, 0.2831542, 5.7756904e-07, 1)
metadata/_custom_type_script = "uid://ch81dd8m0eyf"

[sub_resource type="Resource" id="Resource_gdm1y"]
script = ExtResource("2_data")
id = &"rage"
display_name = "暴怒"
desc = "初始技能的冷却大幅度减少（减少80%），且其伤害附带额外的伤害（附带体质点数/2向下取整）"
color = Color(0.9529412, 0.21960784, 0, 1)
metadata/_custom_type_script = "uid://ch81dd8m0eyf"

[sub_resource type="Resource" id="Resource_d14dd"]
script = ExtResource("2_data")
id = &"consume"
display_name = "消耗"
desc = "通常作为某些装备的效果的代价，使消耗的对象被销毁，若不存在则也不执行其对应的效果"
color = Color(0.89288765, 0.4832611, 0.15505815, 1)
metadata/_custom_type_script = "uid://ch81dd8m0eyf"

[sub_resource type="Resource" id="KeywordData_projectile"]
script = ExtResource("2_data")
id = &"projectile"
display_name = "投射物"
desc = "沿直线飞行并在命中时结算效果的攻击体，不包含抛物线落地结算的抛射物。"
color = Color(0.78, 0.9, 1, 1)

[sub_resource type="Resource" id="KeywordData_thrown"]
script = ExtResource("2_data")
id = &"thrown"
display_name = "抛射物"
desc = "沿抛物线飞行，通常在落地时结算范围效果的攻击体。"
color = Color(0.72, 0.84, 1, 1)

[sub_resource type="Resource" id="KeywordData_all_primary_stats"]
script = ExtResource("2_data")
id = &"all_primary_stats"
display_name = "全属性"
desc = "全部一级属性：力量、敏捷、智力、体质、速度、魅力、幸运。"
color = Color(1, 0.86, 0.5, 1)

[sub_resource type="Resource" id="KeywordData_crit_chance"]
script = ExtResource("2_data")
id = &"crit_chance"
display_name = "暴击率"
desc = "造成伤害时触发暴击的概率。暴击伤害通常会按暴击伤害倍率放大。"
color = Color(1, 0.78, 0.32, 1)

[sub_resource type="Resource" id="KeywordData_sell_price"]
script = ExtResource("2_data")
id = &"sell_price"
display_name = "售价"
desc = "把装备出售给商店时可以获得的金币数量。"
color = Color(1, 0.72, 0.25, 1)

[sub_resource type="Resource" id="KeywordData_level_up_refresh"]
script = ExtResource("2_data")
id = &"level_up_refresh"
display_name = "升级奖励刷新"
desc = "在升级奖励界面重新随机一组奖励的机会。"
color = Color(0.72, 1, 0.78, 1)

[resource]
script = ExtResource("1_db")
keywords = Array[ExtResource("2_data")]([SubResource("KeywordData_armor"), SubResource("KeywordData_weak"), SubResource("KeywordData_strength"), SubResource("KeywordData_dexterity"), SubResource("KeywordData_intelligence"), SubResource("KeywordData_constitution"), SubResource("KeywordData_speed"), SubResource("KeywordData_charm"), SubResource("KeywordData_luck"), SubResource("KeywordData_bleed"), SubResource("KeywordData_freeze"), SubResource("KeywordData_sleep"), SubResource("KeywordData_paralysis"), SubResource("KeywordData_slow"), SubResource("KeywordData_gold"), SubResource("KeywordData_shop_refresh"), SubResource("KeywordData_active_skill"), SubResource("KeywordData_consumable"), SubResource("KeywordData_physical_damage"), SubResource("KeywordData_heal"), SubResource("KeywordData_sharp"), SubResource("KeywordData_vulnerable"), SubResource("Resource_5ukev"), SubResource("Resource_gdm1y"), SubResource("Resource_d14dd"), SubResource("KeywordData_projectile"), SubResource("KeywordData_thrown"), SubResource("KeywordData_all_primary_stats"), SubResource("KeywordData_crit_chance"), SubResource("KeywordData_sell_price"), SubResource("KeywordData_level_up_refresh")])
