[resource]
script = ExtResource("1_pool")
lines = Array[String](["欢迎，欢迎。今天想让命运给你打几折？", "坐吧，别急着走。好东西会自己挑主人。", "你来得正好，我刚擦亮了这些小玩意儿。"])
