[gd_resource type="Resource" script_class="ProfileEventData" format=3]
[ext_resource type="Script" path="res://scripts/profile/profile_event_data.gd" id="1"]
[resource]
script = ExtResource("1")
event_id = &"zhang_san_facilities_ready"
display_name = "我的超能力是杂活"
description = "交付三种设施后，张三开始改善家园并收集大家的好心情。此后每完成一整局冒险，无论胜败，都增加一次收获机会。"
required_completed_event_ids = Array[StringName]([&"zhang_san_requested"])
