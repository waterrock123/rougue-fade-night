[gd_resource type="Resource" script_class="ProfileEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/profile/profile_event_data.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
event_id = &"warehouse_upgrade_plan_completed"
display_name = "垃圾堆升级计划"
description = "你携带装有数据收集器的仓库装备完成了一次荒域旅途。迷途记录员利用带回的数据改造了仓库，使仓库容量从 8 格扩充至 16 格。"
required_completed_event_ids = Array[StringName]([&"warehouse_relic_field_test_complete"])
unlock_content_ids = Array[StringName]([&"warehouse_capacity_upgrade_1"])
