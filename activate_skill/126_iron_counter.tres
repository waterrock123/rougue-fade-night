skill_name = "铁壁反击"
desc = "朝鼠标方向防御0.8秒，移动速度降低50%，期间不能使用其他技能。正面180度攻击伤害降低60%；前0.25秒精准格挡使该次伤害降低90%，随后向前方反击，造成25+{strength}×1.2的{melee_damage}与高削韧，并恢复5能量。每次最多反击一次，持续伤害、地形伤害不能触发，不免疫控制。"
icon = ExtResource("3")
