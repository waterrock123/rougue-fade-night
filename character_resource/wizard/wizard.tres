[resource]
script = ExtResource("1_hx1pq")
character_name = "贵人"
description = "元素，契约，通灵，诸多玄之又玄的力量被她掌握在手中，她举手投足都展现着神秘。不过目前她似乎因为没有得到应有的尊重而生闷气。"
background = ExtResource("1_nvmwb")
start_stats = ExtResource("3_gkwth")
start_inventory = SubResource("Resource_rc2xq")
start_equipment = SubResource("Resource_wtpev")
