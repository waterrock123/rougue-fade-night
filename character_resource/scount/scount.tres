[resource]
script = ExtResource("1_h4k1b")
id = &"scount"
character_name = "浪子"
description = "游侠，盗贼，赏金猎人，他更喜欢称自己为浪子。只接受自己喜欢的委托。鉴于已经许久没见过夜色，他得启程寻回自己的夜晚。"
background = ExtResource("1_uydww")
visual_data = ExtResource("16_5pn2e")
start_stats = ExtResource("6_8bywt")
start_skill = SubResource("Resource_exhr1")
start_inventory = SubResource("Resource_ot4tr")
start_equipment = SubResource("Resource_eux3f")
start_shop = ExtResource("11_eux3f")
start_shop_config = ExtResource("12_f3q0j")
shop_keeper_pool = Array[ExtResource("3_q840c")]([ExtResource("4_8bywt"), ExtResource("5_qoufy"), ExtResource("6_gbtis"), ExtResource("7_5pn2e")])
main_attributes = Array[StringName]([&"dexterity", &"speed"])
metadata/_custom_type_script = "uid://dx5w85r6ff3q4"
