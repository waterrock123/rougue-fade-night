[sub_resource type="Resource" id="Resource_17x8v"]
script = ExtResource("1_wpb77")
lines = Array[String](["别攻击我！我是正常蘑菇怪！", "先声明一下，我这不是胖，是大胃袋。", "我这卖的小零食可是全草原最廉价的了！"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_g2k06"]
script = ExtResource("1_wpb77")
lines = Array[String](["希望下次见面时别再认错蘑菇了。", "欢迎再来啊！", "小心外面那些坏蘑菇啊，它们都因为大魔王给的工资甘愿俯首称臣。"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_bjbtn"]
script = ExtResource("1_wpb77")
lines = Array[String](["不知道这玩意儿能不能吃。。。", "就值这个价，不能再多了！", "不支持讲价，请谅解！"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

