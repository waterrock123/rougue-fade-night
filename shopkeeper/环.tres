[sub_resource type="Resource" id="Resource_bkrw4"]
script = ExtResource("1_3qq7e")
lines = Array[String](["老实说，我很想免费送给你，但是交易是这样的，我们之间的情分还没到这一地步。", "再多买点，我或许会邀请你到我的庄园来玩。", "每一件物品中都有一个梦。", "我头上的红花很土？那是你没欣赏的能力。"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_sdg1l"]
script = ExtResource("1_3qq7e")
lines = Array[String](["早上好，中午好，以及晚上好。", "我已经开始讨厌这份工作了。", "我好像在梦里见过你。"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_741p7"]
script = ExtResource("1_3qq7e")
lines = Array[String](["再见，再见，愿你的梦永不破碎。", "我有一个白色的妹妹，你要是见到她就跟她说：“我想她了”。"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_1loh5"]
script = ExtResource("1_3qq7e")
lines = Array[String](["又收集了一个梦，希望它不要太早破碎。", "各取所需，平等的交易。", "想要我的火么？什么，不想？好吧，给你金币，没有情调的家伙。"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="AtlasTexture" id="AtlasTexture_002qs"]
