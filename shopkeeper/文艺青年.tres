[sub_resource type="Resource" id="Resource_qyxhp"]
script = ExtResource("5_6i865")
lines = Array[String](["收获满满！", "是不是很赚？", "这可是寄托了我心意的物件，便宜你了"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_0raca"]
script = ExtResource("5_6i865")
lines = Array[String](["哈喽，要不要来跟我打羽毛球？", "慢慢看，我这里都是些贵族才用得起的好物"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_31m6l"]
script = ExtResource("5_6i865")
lines = Array[String](["拜拜，如果以后交了大姐姐朋友的话，记得推荐给我哦", "好朋友，以后要常来啊"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[sub_resource type="Resource" id="Resource_jwiby"]
script = ExtResource("5_6i865")
lines = Array[String](["不错物件，它值这个价钱", "这已经是我能给出最好的价格了，不能再多了哦", "这物件，让我涌现了创作的灵感！"])
metadata/_custom_type_script = "uid://2d8755uj7qel"

[resource]
script = ExtResource("3_g23cf")
name = "姓安的文艺青年"
texture = ExtResource("7_01kpb")
