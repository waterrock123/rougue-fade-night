[gd_resource type="Resource" script_class="StatusData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/status/status_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/status/status_ability_cooldown_effect.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/status/status_effect.gd" id="3_base"]

[sub_resource type="Resource" id="Resource_cooldown"]
script = ExtResource("2_effect")
cooldown_override = 0.01
reset_current_cooldowns = true

[resource]
script = ExtResource("1_data")
id = &"reincarnation_casting"
status_name = "轮回施法"
desc = "基础攻击与全部主动技能冷却固定为0.01秒，持续10秒。仍需满足能量、弹药及行动限制。"
duration = 10.0
polarity = 1
effects = Array[ExtResource("3_base")]([SubResource("Resource_cooldown")])
