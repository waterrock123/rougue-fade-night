[resource]
script = ExtResource("2_data")
id = &"bleed"
status_name = "流血"
desc = "首次获得时持续30秒；每5秒受到等同于流血层数的物理伤害，并使随机一级属性-1直到战斗结束。再次获得流血会增加层数并延长持续时间，最多30秒。"
icon = ExtResource("4_icon")
duration = 30.0
max_stacks = 50
stack_mode = 1
refresh_duration_on_reapply = false
add_duration_on_reapply = true
max_duration = 30.0
effects = Array[ExtResource("1_base")]([SubResource("BleedPeriodicDamage")])
