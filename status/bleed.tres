[sub_resource type="Resource" id="BleedPeriodicDamage"]
script = ExtResource("3_periodic_damage")
damage_tags = Array[String](["status", "bleed", "physical"])
penalty_status_desc = "流血使随机一级属性降低，持续到本场战斗结束。"
