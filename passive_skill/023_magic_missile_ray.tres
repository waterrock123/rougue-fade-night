[resource]
script = ExtResource("1")
effects = Array[ExtResource("2")]([SubResource("Tuning")])
id = &"023"
skill_name = "魔法飞弹-射线"
desc = "基础攻击改为按住蓄力、松开释放。点按发射普通魔法飞弹，基础蓄力3.5秒时飞弹伤害达到原伤害的200%，蓄力时间随基础攻击的冷却减免同比缩短。满蓄力额外向鼠标方向发射持续2秒、射程160的激光，缓慢跟随鼠标转向，每0.2秒造成2.5+{intelligence}的闪电伤害，期间可以移动。不继承进阶的增伤与冷却减半。"
icon = SubResource("Icon")
is_upgrade_skill = true
allowed_character_ids = Array[StringName]([&"wizard"])
