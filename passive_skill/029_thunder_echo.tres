id = &"029"
skill_name = "雷鸣余响"
desc = "雷元素的非基础主动技能每累计3次有效命中，向附近另一名敌人放电，造成10+{intelligence}的{lightning}。同次施法最多放电一次，连锁伤害不触发此类技能被动。"
icon = SubResource("Icon")
allowed_character_ids = Array[StringName]([&"wizard"])
upgrade_options = Array[ExtResource("Skill")]([ExtResource("Upgrade")])
