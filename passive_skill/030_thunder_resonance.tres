[gd_resource type="Resource" script_class="PassiveSkillData" format=3]

[ext_resource type="Script" path="res://scripts/skill/passive_skill_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/skill/passive_skill_effect.gd" id="2"]
[ext_resource type="Script" path="res://scripts/skill/passive_element_hit_chain_effect.gd" id="3"]
[ext_resource type="Texture2D" path="res://assets/特效/Effect and Bullet 16x16/Effect and Bullet 16x16/Purple Effect and Bullet 16x16.png" id="4"]

[ext_resource type="Script" path="res://scripts/stats/damage_scaling_rule.gd" id="ScalingScript"]
[ext_resource type="Resource" path="res://status/paralysis.tres" id="Status"]

[sub_resource type="Resource" id="Scaling"]
script = ExtResource("ScalingScript")
physical_formula = ""
ranged_formula = ""
lightning_formula = "intelligence"

[sub_resource type="Resource" id="Effect"]
script = ExtResource("3")
chain_count = 3
scaling_rule = SubResource("Scaling")
hit_status = ExtResource("Status")

[sub_resource type="AtlasTexture" id="Icon"]
atlas = ExtResource("4")
region = Rect2(160, 16, 16, 16)

[resource]
script = ExtResource("1")
effects = Array[ExtResource("2")]([SubResource("Effect")])
id = &"030"
skill_name = "雷霆共振"
desc = "雷元素的非基础主动技能每累计3次有效命中，向附近其他敌人连锁放电，最多命中3个不同敌人，各造成10+{intelligence}的{lightning}并施加1层{paralysis}。同次施法最多触发一次，连锁伤害不触发此类技能被动。"
icon = SubResource("Icon")
allowed_character_ids = Array[StringName]([&"wizard"])
is_upgrade_skill = true
