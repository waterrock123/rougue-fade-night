[resource]
script = ExtResource("1")
effects = Array[ExtResource("2")]([SubResource("Effect")])
id = &"038"
skill_name = "游猎本能"
desc = "连续主动移动1秒后，使下一次整次基础攻击伤害提高50%；使用强化攻击后，额外获得20%移动速度，持续2秒，重复触发刷新时间。强化可保留至使用，使用后重新积累。"
icon = ExtResource("4")
allowed_character_ids = Array[StringName]([&"scount"])
is_upgrade_skill = true
