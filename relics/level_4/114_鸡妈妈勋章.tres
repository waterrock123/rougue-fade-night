[sub_resource type="Resource" id="ChickenMedalArmor"]
script = ExtResource("3_add_status")
status_data = ExtResource("7_armor")
stacks = 2

[sub_resource type="Resource" id="ChickenMedalEggBonus"]
script = ExtResource("4_inventory_count")
target_relic_id = "112"
stat_bonuses_per_relic = {
"charm": 1.0,
"constitution": 1.0,
"dexterity": 1.0,
"intelligence": 1.0,
"luck": 1.0,
"speed": 1.0,
"strength": 1.0
}

[sub_resource type="Resource" id="ChickenMedalWeight"]
script = ExtResource("5_weight")
object_id = &"animal_chicken"
weight_bonus = 2.0

[sub_resource type="Resource" id="ChickenMedalSpawnStats"]
script = ExtResource("6_spawn_stats")
object_id = &"animal_chicken"
add_stats = {
"dexterity": 5.0,
"strength": 5.0
}
status_name = "鸡妈妈的祝福"
status_desc = "本场战斗中力量和敏捷 +5。"

[resource]
script = ExtResource("1_relic")
relic_name = "鸡妈妈勋章"
tooltip = "护甲 +2；背包内每有一件鸡蛋，全属性 +1；提高地图中鸡的出现权重。
升级：地图中出现鸡时，力量和敏捷 +5。"
desc = "一枚会吸引鸡群的勋章。"
price = 8
sell_price = 4
level = 4
tags = Array[ExtResource("8_tag")]([ExtResource("9_stock"), ExtResource("10_defense")])
id = "114"
effects = Array[ExtResource("2_base")]([SubResource("ChickenMedalArmor"), SubResource("ChickenMedalEggBonus"), SubResource("ChickenMedalWeight")])
great_effects = Array[ExtResource("2_base")]([SubResource("ChickenMedalSpawnStats")])
