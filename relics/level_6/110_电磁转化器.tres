[resource]
script = ExtResource("2_3q0u0")
relic_name = "电磁转化器"
tooltip = "在战斗中电力层数被消耗时立刻获得一层电力，
消耗电力层数时有5%的概率使自身随机属性+1
并持续至战斗结束
升级：概率提升至10%"
