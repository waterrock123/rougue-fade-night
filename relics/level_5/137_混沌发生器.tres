[resource]
script = ExtResource("2_5in3g")
id = "137"
relic_name = "混沌发生器"
icon = ExtResource("Icon_completion_20261012")
tooltip = "装备期间，使所有{map_special_object}的随机出现概率与数量提升100%（概率最高100%）。获得时立即随机触发一项非默认天气或环境。
升级：获得升级态或升级时，立即将本局基础一级属性的总点数重新随机分配，并将非基础攻击、非装备提供的全部已拥有{active_skill}重随机。保留携带状态、技能阶段及角色归属，不重复；没有可替代技能时保留原样。重新穿戴不重复触发。"
desc = "这个装置的原理参考荒域本身，其目的在于将荒域修改为正常的环境，可惜还在研发中，强行介入荒域会导致更大的混乱"
price = 5
level = 5
effects = Array[ExtResource("1_l8nov")]([SubResource("Resource_map"), SubResource("Resource_condition")])
great_effects = Array[ExtResource("1_l8nov")]([SubResource("Resource_stats"), SubResource("Resource_skills")])
tags = Array[ExtResource("3_v3f00")]([ExtResource("4_v3f00"), ExtResource("5_xuwjr")])
